[Unit]
Description=XiaoAi LLM Bridge
After=network.target

[Service]
Type=simple
User=root
# 按实际克隆路径修改下面两行（README 默认克隆到 /root/migpt-all）
WorkingDirectory=/root/migpt-all
ExecStart=/usr/bin/python3 /root/migpt-all/main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# 如果用环境变量配置：
# Environment=XIAOMI_ACCOUNT=your_account
# Environment=XIAOMI_PASSWORD=your_password
# Environment=LLM_API_URL=http://127.0.0.1:9222

[Install]
WantedBy=multi-user.target
